{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git show *)",
      "Bash(git branch --show-current *)",
      "Bash(git branch --list *)",
      "Bash(git remote get-url *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list *)",
      "Bash(git fetch *)",
      "Bash(git diff --stat *)",
      "Bash(git pull --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git push * alfred/*)",
      "Bash(git push * agent/*)",
      "Bash(git push * docs/*)",
      "Bash(git push * feat/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(az boards work-item create *)",
      "Bash(az boards work-item show *)",
      "Bash(az boards work-item update *)",
      "Bash(az boards query *)",
      "Bash(az devops project show *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * main)",
      "Bash(git push * :main)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue close *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Read(~/.codex/**)",
      "Bash(az boards work-item delete *)",
      "Bash(az boards area *)",
      "Bash(az boards iteration *)",
      "Bash(az pipelines *)",
      "Bash(az repos *)",
      "Bash(az devops team *)",
      "Bash(az devops admin *)",
      "Bash(az devops security *)",
      "Bash(az devops user *)",
      "Bash(az devops extension *)",
      "Bash(az devops service-endpoint *)",
      "Bash(az devops project create *)",
      "Bash(az devops project delete *)",
      "Bash(az devops invoke *)",
      "Bash(az rest *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) uv run ruff format \"$f\" && uv run ruff check --fix \"$f\" ;; esac"
          }
        ]
      }
    ]
  }
}
